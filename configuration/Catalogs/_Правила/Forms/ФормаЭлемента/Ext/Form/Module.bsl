&НаСервере
Процедура УсловияОпределитьТипыЗначений()
	Для Каждого стрДействия ИЗ ЭтаФорма.Объект.Действия Цикл
		
		стрДействия.ЭтоВидЗначения_Значение = Ложь;
		стрДействия.ЭтоВидЗначения_Функция = Ложь;
		стрДействия.ЭтоВидЗначения_ИзРеквизитаФункцРоли = Ложь;
		Если ЗначениеЗаполнено(стрДействия.Действие_ФункциональнаяРоль) Тогда
			стрДействия.ЭтоВидЗначения_ИзРеквизитаФункцРоли = Истина;
		ИначеЕсли ЗначениеЗаполнено(стрДействия.ФункцияПолученияЗначения) Тогда
			стрДействия.ЭтоВидЗначения_ИзРеквизитаФункцРоли = Истина;
		Иначе 
			стрДействия.ЭтоВидЗначения_Значение = Истина;
		КонецЕсли;
		
		стрДействия.ТипЗначения = стрДействия.Действие.ТипЗначения;
		
		стрДействия.Представление = "";
		//стрДействия.Представление = стрДействия.Представление+" "+стрДействия.ФункциональнаяРоль.Код+"["+стрДействия.ВидРеквизита+"]";
		стрДействия.Представление = стрДействия.Представление+" "+стрДействия.Действие;
		Если стрДействия.СпособВычисленияЗначения = ПредопределенноеЗначение("Перечисление._СпособыВычисленияЗначения.Функция") Тогда
			стрДействия.Представление = стрДействия.Представление+" "+стрДействия.ФункцияПолученияЗначения+"()";
		ИначеЕсли стрДействия.СпособВычисленияЗначения = ПредопределенноеЗначение("Перечисление._СпособыВычисленияЗначения.ИзРеквизитаФРоли") Тогда
			стрДействия.Представление = стрДействия.Представление+" "+стрДействия.Действие_ФункциональнаяРоль+"["+стрДействия.Действие_ВидРеквизита+"]";
		Иначе //Если ТекущиеДанные.СпособВычисленияЗначения = ПредопределенноеЗначение("Перечисление._СпособыВычисленияЗначения.Значение") Тогда
			стрДействия.Представление = стрДействия.Представление+" "+стрДействия.ЗначениеРеквизита;
		КонецЕсли;
		
	КонецЦикла;

	Для Каждого стрУсловия ИЗ ЭтаФорма.Объект.Условия Цикл
		Если ЗначениеЗаполнено(стрУсловия.ВидРеквизитаДополнение) Тогда
			стрУсловия.ТипЗначения = стрУсловия.ВидРеквизитаДополнение;
		Иначе	
			стрУсловия.ТипЗначения = стрУсловия.ВидРеквизита;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
#КонецОбласти

