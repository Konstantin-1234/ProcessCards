#Область РаботаСДеревомУсловий

// Описание процедур и функций области РаботаСДеревомУсловий:
//
// УсловияДеревоСформироватьПредставлениеНаКлиенте(СтрокаДерева) - формирует текстовое представление условия на клиенте
// УсловияДеревоСформироватьПредставлениеНаСервере(СтрокаДерева) - формирует текстовое представление условия на сервере
// УсловияДеревоПолучитьЗначениеДляОтображенияИзТЧ(СтрокаТЧУсловия, НомерУсловия) - получает значение для отображения из табличной части
// УсловияДеревоЗаписатьЗначениеВТЧ(НоваяСтрока, СтрокаДерева, НомерУсловия) - записывает значение в табличную часть
// УсловияДеревоЗаполнитьУсловие(НомерУсловия, СтрокаДерева, СтрокаТЧУсловия) - заполняет поля одного условия (1 или 2) в строке дерева
// УсловияДеревоЗаполнитьНаСервере() - заполняет дерево условий из табличной части объекта
// УсловияДеревоСохранитьНаСервере() - сохраняет дерево условий в табличную часть объекта
// УсловияДеревоНайтиУзелГруппыНаСервере(Группа) - находит узел группы в дереве
// УсловияДеревоНайтиУзелРолиНаСервере(УзелГруппы, ФункциональнаяРоль) - находит узел роли в дереве
// УсловияДеревоВыбратьФункциональнуюРоль() - открывает форму выбора функциональной роли
// УсловияДеревоДобавитьУсловие(Команда) - обработчик команды, добавляет новое условие в дерево
// УсловияДеревоДобавитьУзелНаСервере(Группа, ФункциональнаяРоль) - добавляет узел в дерево на сервере
// УсловияДеревоУдалитьУсловиеНаСервере() - удаляет условие на сервере (заглушка)
// УсловияДеревоУдалитьУсловие(Команда) - обработчик команды, удаляет условие из дерева
// УсловияДеревоПриИзменении(Элемент) - обработчик изменения дерева условий, обновляет представление и тип отображения

&НаКлиенте
Функция УсловияДеревоСформироватьПредставлениеНаКлиенте(СтрокаДерева)
	ТекстПредставления = "";
	
	Если ЗначениеЗаполнено(СтрокаДерева.ВидРеквизита) Тогда
		ТекстПредставления = Строка(СтрокаДерева.ВидРеквизита);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаДерева.ВидРеквизитаДополнение) Тогда
		ТекстПредставления = ТекстПредставления + "." + Строка(СтрокаДерева.ВидРеквизитаДополнение);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаДерева.Сравнение_1) Тогда
		ТекстПредставления = ТекстПредставления + " " + Строка(СтрокаДерева.Сравнение_1);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаДерева.ЗначениеДляОтображения_1) Тогда
		ТекстПредставления = ТекстПредставления + " " + Строка(СтрокаДерева.ЗначениеДляОтображения_1);
	КонецЕсли;
	
	Возврат ТекстПредставления;
КонецФункции

&НаСервере
Функция УсловияДеревоСформироватьПредставлениеНаСервере(СтрокаДерева)
	ТекстПредставления = "";
	
	Если ЗначениеЗаполнено(СтрокаДерева.ВидРеквизита) Тогда
		ТекстПредставления = Строка(СтрокаДерева.ВидРеквизита);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаДерева.ВидРеквизитаДополнение) Тогда
		ТекстПредставления = ТекстПредставления + "." + Строка(СтрокаДерева.ВидРеквизитаДополнение);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаДерева.Сравнение_1) Тогда
		ТекстПредставления = ТекстПредставления + " " + Строка(СтрокаДерева.Сравнение_1);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаДерева.ЗначениеДляОтображения_1) Тогда
		ТекстПредставления = ТекстПредставления + " " + Строка(СтрокаДерева.ЗначениеДляОтображения_1);
	КонецЕсли;
	
	Возврат ТекстПредставления;
КонецФункции

&НаСервере
Функция УсловияДеревоПолучитьЗначениеДляОтображенияИзТЧ(СтрокаТЧУсловия, НомерУсловия)
	
	Способ = СтрокаТЧУсловия["СпособПолученияЗначения_" + НомерУсловия];
	
	Если Способ = ПредопределенноеЗначение("Перечисление._СпособыПолученияЗначенияДляУсловия.Значение") Тогда
		Возврат СтрокаТЧУсловия["ЗначениеРеквизита_" + НомерУсловия];
	ИначеЕсли Способ = ПредопределенноеЗначение("Перечисление._СпособыПолученияЗначенияДляУсловия.Функция") Тогда
		Возврат СтрокаТЧУсловия["ФункцияПолученияЗначения_" + НомерУсловия];
	ИначеЕсли Способ = ПредопределенноеЗначение("Перечисление._СпособыПолученияЗначенияДляУсловия.ИзРеквизита") Тогда
		Возврат СтрокаТЧУсловия["ВидРеквизитаДляСравнения_" + НомерУсловия];
	КонецЕсли;
	
	Возврат Неопределено;
КонецФункции

&НаСервере
Процедура УсловияДеревоЗаписатьЗначениеВТЧ(НоваяСтрока, СтрокаДерева, НомерУсловия)
	
	Способ = СтрокаДерева["СпособПолученияЗначения_" + НомерУсловия];
	Значение = СтрокаДерева["ЗначениеДляОтображения_" + НомерУсловия];
	
	НоваяСтрока["ЗначениеРеквизита_" + НомерУсловия] = Неопределено;
	НоваяСтрока["ФункцияПолученияЗначения_" + НомерУсловия] = Неопределено;
	НоваяСтрока["ВидРеквизитаДляСравнения_" + НомерУсловия] = Неопределено;
	НоваяСтрока["ВидРеквизитаСвязи_" + НомерУсловия] = Неопределено;
	НоваяСтрока["ВидРеквизитаСвязаннойКарточки_" + НомерУсловия] = Неопределено;
	
	Если Способ = ПредопределенноеЗначение("Перечисление._СпособыПолученияЗначенияДляУсловия.Значение") Тогда
		НоваяСтрока["ЗначениеРеквизита_" + НомерУсловия] = Значение;
	ИначеЕсли Способ = ПредопределенноеЗначение("Перечисление._СпособыПолученияЗначенияДляУсловия.Функция") Тогда
		НоваяСтрока["ФункцияПолученияЗначения_" + НомерУсловия] = Значение;
	ИначеЕсли Способ = ПредопределенноеЗначение("Перечисление._СпособыПолученияЗначенияДляУсловия.ИзРеквизита") Тогда
		НоваяСтрока["ВидРеквизитаДляСравнения_" + НомерУсловия] = Значение;
	ИначеЕсли Способ = ПредопределенноеЗначение("Перечисление._СпособыПолученияЗначенияДляУсловия.ИзРеквизитаСвязаннойКарточки") Тогда
		НоваяСтрока["ВидРеквизитаСвязи_" + НомерУсловия] = Значение;
		НоваяСтрока["ВидРеквизитаСвязаннойКарточки_" + НомерУсловия] = Значение;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура УсловияДеревоЗаполнитьУсловие(НомерУсловия, СтрокаДерева, СтрокаТЧУсловия)
	
	СтрокаДерева["Сравнение_" + НомерУсловия] = СтрокаТЧУсловия["Сравнение_" + НомерУсловия];
	СтрокаДерева["СпособПолученияЗначения_" + НомерУсловия] = СтрокаТЧУсловия["СпособПолученияЗначения_" + НомерУсловия];
	
	СтрокаДерева["ЗначениеДляОтображения_" + НомерУсловия] = УсловияДеревоПолучитьЗначениеДляОтображенияИзТЧ(СтрокаТЧУсловия, НомерУсловия);
	
	СтрокаДерева["ЗначениеРеквизита_" + НомерУсловия] = СтрокаТЧУсловия["ЗначениеРеквизита_" + НомерУсловия];
	СтрокаДерева["ФункцияПолученияЗначения_" + НомерУсловия] = СтрокаТЧУсловия["ФункцияПолученияЗначения_" + НомерУсловия];
	СтрокаДерева["ВидРеквизитаДляСравнения_" + НомерУсловия] = СтрокаТЧУсловия["ВидРеквизитаДляСравнения_" + НомерУсловия];
	СтрокаДерева["ВидРеквизитаСвязи_" + НомерУсловия] = СтрокаТЧУсловия["ВидРеквизитаСвязи_" + НомерУсловия];
	СтрокаДерева["ВидРеквизитаСвязаннойКарточки_" + НомерУсловия] = СтрокаТЧУсловия["ВидРеквизитаСвязаннойКарточки_" + НомерУсловия];
	
КонецПроцедуры

&НаСервере
Процедура УсловияДеревоЗаполнитьНаСервере()
	УсловияДерево.ПолучитьЭлементы().Очистить();
	
	СоответствиеГрупп = Новый Соответствие();
	СоответствиеРолей = Новый Соответствие();
	
	Для Каждого СтрокаТЧУсловия Из Объект.Условия Цикл
		
		КлючГруппы = СтрокаТЧУсловия.Группа;
		КлючРоли = СтрокаТЧУсловия.ФункциональнаяРоль;
		
		Если СоответствиеГрупп.Получить(КлючГруппы) = Неопределено Тогда
			ВетвьГруппы = УсловияДерево.ПолучитьЭлементы().Добавить();
			ВетвьГруппы.ЭтоГруппа = Истина;
			ВетвьГруппы.Уровень = 0;
			ВетвьГруппы.Группа = КлючГруппы;
			ВетвьГруппы.Представление = "Группа: " + ?(ЗначениеЗаполнено(КлючГруппы), КлючГруппы, "(не указана)");
			ВетвьГруппы.Иконка = "Папка";
			СоответствиеГрупп.Вставить(КлючГруппы, ВетвьГруппы);
		Иначе
			ВетвьГруппы = СоответствиеГрупп.Получить(КлючГруппы);
		КонецЕсли;
		
		КлючГруппыРоли = Строка(КлючГруппы) + "|" + Строка(КлючРоли);
		Если СоответствиеРолей.Получить(КлючГруппыРоли) = Неопределено Тогда
			ВетвьРоли = ВетвьГруппы.ПолучитьЭлементы().Добавить();
			ВетвьРоли.ЭтоГруппа = Истина;
			ВетвьРоли.Уровень = 1;
			ВетвьРоли.Группа = КлючГруппы;
			ВетвьРоли.ФункциональнаяРоль = КлючРоли;
			ВетвьРоли.Представление = "Роль: " + Строка(КлючРоли);
			ВетвьРоли.Иконка = "Пользователь";
			СоответствиеРолей.Вставить(КлючГруппыРоли, ВетвьРоли);
		Иначе
			ВетвьРоли = СоответствиеРолей.Получить(КлючГруппыРоли);
		КонецЕсли;
		
		СтрокаДерева = ВетвьРоли.ПолучитьЭлементы().Добавить();
		СтрокаДерева.ЭтоГруппа = Ложь;
		СтрокаДерева.Уровень = 2;
		СтрокаДерева.НомерСтрокиОбъекта = Объект.Условия.Индекс(СтрокаТЧУсловия);
		
		СтрокаДерева.Группа = СтрокаТЧУсловия.Группа;
		СтрокаДерева.ФункциональнаяРоль = СтрокаТЧУсловия.ФункциональнаяРоль;
		СтрокаДерева.ВидРеквизита = СтрокаТЧУсловия.ВидРеквизита;
		СтрокаДерева.ВидРеквизитаДополнение = СтрокаТЧУсловия.ВидРеквизитаДополнение;
		
		// Заполнение типа отображения аналогично ТипЗначения в ОпределитьТипыЗначений
		Если ЗначениеЗаполнено(СтрокаТЧУсловия.ВидРеквизитаДополнение) Тогда
			СтрокаДерева.ТипОтображения_1 = СтрокаТЧУсловия.ВидРеквизитаДополнение;
			СтрокаДерева.ТипОтображения_2 = СтрокаТЧУсловия.ВидРеквизитаДополнение;
		Иначе	
			СтрокаДерева.ТипОтображения_1 = СтрокаТЧУсловия.ВидРеквизита;
			СтрокаДерева.ТипОтображения_2 = СтрокаТЧУсловия.ВидРеквизита;
		КонецЕсли;
		
		УсловияДеревоЗаполнитьУсловие("1", СтрокаДерева, СтрокаТЧУсловия);
		УсловияДеревоЗаполнитьУсловие("2", СтрокаДерева, СтрокаТЧУсловия);
		
		СтрокаДерева.Представление = УсловияДеревоСформироватьПредставлениеНаСервере(СтрокаДерева);
		СтрокаДерева.Иконка = "Условие";
		
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура УсловияДеревоСохранитьНаСервере()
	Объект.Условия.Очистить();
	
	Для Каждого ВетвьГруппы Из УсловияДерево.ПолучитьЭлементы() Цикл
		Для Каждого ВетвьРоли Из ВетвьГруппы.ПолучитьЭлементы() Цикл
			Для Каждого СтрокаДерева Из ВетвьРоли.ПолучитьЭлементы() Цикл
				
				Если НЕ СтрокаДерева.ЭтоГруппа И СтрокаДерева.Уровень = 2 Тогда
					НоваяСтрока = Объект.Условия.Добавить();
					
					НоваяСтрока.Группа = СтрокаДерева.Группа;
					НоваяСтрока.ФункциональнаяРоль = СтрокаДерева.ФункциональнаяРоль;
					НоваяСтрока.ВидРеквизита = СтрокаДерева.ВидРеквизита;
					НоваяСтрока.ВидРеквизитаДополнение = СтрокаДерева.ВидРеквизитаДополнение;
					
					НоваяСтрока.Сравнение_1 = СтрокаДерева.Сравнение_1;
					НоваяСтрока.СпособПолученияЗначения_1 = СтрокаДерева.СпособПолученияЗначения_1;
					УсловияДеревоЗаписатьЗначениеВТЧ(НоваяСтрока, СтрокаДерева, "1");
					
					НоваяСтрока.Сравнение_2 = СтрокаДерева.Сравнение_2;
					НоваяСтрока.СпособПолученияЗначения_2 = СтрокаДерева.СпособПолученияЗначения_2;
					УсловияДеревоЗаписатьЗначениеВТЧ(НоваяСтрока, СтрокаДерева, "2");
				КонецЕсли;
				
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция УсловияДеревоНайтиУзелГруппыНаСервере(Группа)
	Для Каждого Узел Из УсловияДерево.ПолучитьЭлементы() Цикл
		Если Узел.ЭтоГруппа И Узел.Уровень = 0 И Узел.Группа = Группа Тогда
			Возврат Узел;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

&НаСервере
Функция УсловияДеревоНайтиУзелРолиНаСервере(УзелГруппы, ФункциональнаяРоль)
	Для Каждого Узел Из УзелГруппы.ПолучитьЭлементы() Цикл
		Если Узел.ЭтоГруппа И Узел.Уровень = 1 И Узел.ФункциональнаяРоль = ФункциональнаяРоль Тогда
			Возврат Узел;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

&НаКлиенте
Функция УсловияДеревоВыбратьФункциональнуюРоль()
	ПараметрыВыбора = Новый Структура;
	ПараметрыВыбора.Вставить("МножественныйВыбор", Ложь);
	
	ФормаВыбора = ОткрытьФорму("Справочник._ФункциональныеРоли.ФормаСписка", ПараметрыВыбора, ЭтотОбъект);
	
	Если ФормаВыбора <> Неопределено И ФормаВыбора.ВыбраннаяСтрока <> Неопределено Тогда
		Возврат ФормаВыбора.ВыбраннаяСтрока.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
КонецФункции

&НаКлиенте
Процедура УсловияДеревоДобавитьУсловие(Команда)
	ТекУзел = Элементы.УсловияДерево.ТекущаяСтрока;
	
	Группа = Неопределено;
	ФункциональнаяРоль = Неопределено;
	
	Если ТекУзел <> Неопределено Тогда
		Если ТекУзел.ЭтоГруппа И ТекУзел.Уровень = 0 Тогда
			Группа = ТекУзел.Группа;
		ИначеЕсли ТекУзел.ЭтоГруппа И ТекУзел.Уровень = 1 Тогда
			Группа = ТекУзел.Группа;
			ФункциональнаяРоль = ТекУзел.ФункциональнаяРоль;
		ИначеЕсли НЕ ТекУзел.ЭтоГруппа И ТекУзел.Уровень = 2 Тогда
			Группа = ТекУзел.Группа;
			ФункциональнаяРоль = ТекУзел.ФункциональнаяРоль;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ФункциональнаяРоль) Тогда
		ФункциональнаяРоль = УсловияДеревоВыбратьФункциональнуюРоль();
		Если НЕ ЗначениеЗаполнено(ФункциональнаяРоль) Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	УсловияДеревоДобавитьУзелНаСервере(Группа, ФункциональнаяРоль);
КонецПроцедуры

&НаСервере
Процедура УсловияДеревоДобавитьУзелНаСервере(Группа, ФункциональнаяРоль)
	
	ВетвьГруппы = УсловияДеревоНайтиУзелГруппыНаСервере(Группа);
	Если ВетвьГруппы = Неопределено Тогда
		ВетвьГруппы = УсловияДерево.ПолучитьЭлементы().Добавить();
		ВетвьГруппы.ЭтоГруппа = Истина;
		ВетвьГруппы.Уровень = 0;
		ВетвьГруппы.Группа = Группа;
		ВетвьГруппы.Представление = "Группа: " + ?(ЗначениеЗаполнено(Группа), Группа, "(не указана)");
		ВетвьГруппы.Иконка = "Папка";
	КонецЕсли;
	
	ВетвьРоли = УсловияДеревоНайтиУзелРолиНаСервере(ВетвьГруппы, ФункциональнаяРоль);
	Если ВетвьРоли = Неопределено Тогда
		ВетвьРоли = ВетвьГруппы.ПолучитьЭлементы().Добавить();
		ВетвьРоли.ЭтоГруппа = Истина;
		ВетвьРоли.Уровень = 1;
		ВетвьРоли.Группа = Группа;
		ВетвьРоли.ФункциональнаяРоль = ФункциональнаяРоль;
		ВетвьРоли.Представление = "Роль: " + Строка(ФункциональнаяРоль);
		ВетвьРоли.Иконка = "Пользователь";
	КонецЕсли;
	
	НовыйУзел = ВетвьРоли.ПолучитьЭлементы().Добавить();
	НовыйУзел.ЭтоГруппа = Ложь;
	НовыйУзел.Уровень = 2;
	НовыйУзел.Группа = Группа;
	НовыйУзел.ФункциональнаяРоль = ФункциональнаяРоль;
	НовыйУзел.Представление = "Новое условие";
	НовыйУзел.Иконка = "Условие";
	
	УсловияДеревоСохранитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура УсловияДеревоУдалитьУсловие(Команда)
	ТекУзел = Элементы.УсловияДерево.ТекущаяСтрока;
	
	Если ТекУзел = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Родитель = ТекУзел.Родитель;
	Если Родитель <> Неопределено Тогда
		Родитель.ПолучитьЭлементы().Удалить(ТекУзел);
		
		Если Родитель.ПолучитьЭлементы().Количество() = 0 Тогда
			РодительРодителя = Родитель.Родитель;
			Если РодительРодителя <> Неопределено Тогда
				РодительРодителя.ПолучитьЭлементы().Удалить(Родитель);
				
				Если РодительРодителя.ПолучитьЭлементы().Количество() = 0 Тогда
					УсловияДерево.ПолучитьЭлементы().Удалить(РодительРодителя);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	Иначе
		УсловияДерево.ПолучитьЭлементы().Удалить(ТекУзел);
	КонецЕсли;
	
	УсловияДеревоСохранитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура УсловияДеревоПриИзменении(Элемент)
	ТекУзел = Элементы.УсловияДерево.ТекущиеДанные;
	Если ТекУзел <> Неопределено И НЕ ТекУзел.ЭтоГруппа И ТекУзел.Уровень = 2 Тогда
		
		// Автоматическое определение типа отображения при изменении вида реквизита
		Если ЗначениеЗаполнено(ТекУзел.ВидРеквизитаДополнение) Тогда
			ТекУзел.ТипОтображения_1 = ТекУзел.ВидРеквизитаДополнение;
			ТекУзел.ТипОтображения_2 = ТекУзел.ВидРеквизитаДополнение;
		Иначе	
			ТекУзел.ТипОтображения_1 = ТекУзел.ВидРеквизита;
			ТекУзел.ТипОтображения_2 = ТекУзел.ВидРеквизита;
		КонецЕсли;
		
		ТекУзел.Представление = УсловияДеревоСформироватьПредставлениеНаКлиенте(ТекУзел);
		УсловияДеревоСохранитьНаСервере();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

