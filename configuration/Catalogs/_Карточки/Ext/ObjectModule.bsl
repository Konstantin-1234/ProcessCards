Процедура ПриЗаписи(Отказ)
	ДокументДвижения = Документы._ДвиженияКарточки.СоздатьДокумент();
	// Заполняем основные реквизиты документа
	ДокументДвижения.Дата = ТекущаяДатаСеанса();
	ДокументДвижения.Карточка = ЭтотОбъект.Ссылка;

	ЭтотОбъект.ДополнительныеСвойства.Вставить("ДокументДвижения",ДокументДвижения);
	
	// Вызов процедуры инициализации, Если карточка стартована, то старт будет остановлен.
	СтартоватьКарточку();
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("СохраняемыеРеквизиты") Тогда
		СохранитьРеквизиты();
	КонецЕсли;


	// Проверяем, имеются ли строки в табличной части ДокументДвижения
	Если ДокументДвижения.Реквизиты.Количество() > 0 Тогда
		// Проводим документ
		ДокументДвижения.Записать(РежимЗаписиДокумента.Проведение);
	КонецЕсли;
	
КонецПроцедуры

Процедура СтартоватьКарточку()
	
	// Проверяем, заполнен ли реквизит ВидКарточки
	Если НЕ ЗначениеЗаполнено(ЭтотОбъект.ВидКарточки)
		
	Тогда
		// Если вид карточки не задан, инициализация невозможна
		Возврат;
	КонецЕсли;
	
	// Проверяем, есть ли уже какие-либо движения для данной карточки в регистре _СостояниеКарточек
	// Если да - инициализация не требуется, выходим.
	Если ЗначениеЗаполнено(Документы._ДвиженияКарточки.НайтиПоРеквизиту("Карточка",ЭтотОбъект.Ссылка)) Тогда
		Возврат;
	КонецЕсли;
	
	// Дальнейший код выполняется, только если движений не было
	
	ДокументДвижения = ЭтотОбъект.ДополнительныеСвойства.ДокументДвижения;
	
	// Заполняем основные реквизиты документа
	ДокументДвижения.Дата = ТекущаяДатаСеанса();
	ДокументДвижения.Карточка = ЭтотОбъект.Ссылка;
	ДокументДвижения.Комментарий = "Стартовое заполнение реквизитов";
	
	// Получаем табличную часть "Реквизиты" из шаблона вида карточки
	// Для этого прочитаем все реквизиты, связанные с данным ВидомКарточки
	// Включая теперь поле "Действие" из шаблона
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВидыКарточекТабличнаяЧасть.ВидРеквизита,
		|	ВидыКарточекТабличнаяЧасть.СтартовоеЗначениеРеквизита,
		|	ВидыКарточекТабличнаяЧасть.СтартовоеДействие
		|ИЗ
		|	Справочник._ВидыКарточек.Реквизиты КАК ВидыКарточекТабличнаяЧасть
		|ГДЕ
		|	ВидыКарточекТабличнаяЧасть.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.ВидКарточки);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	// Перебираем строки табличной части вида карточки
	Пока Выборка.Следующий() Цикл
		
		// Проверяем, задано ли действие в шаблоне
		Если НЕ ЗначениеЗаполнено(Выборка.СтартовоеДействие) Тогда
			// Если действие не задано, пропускаем этот реквизит
			Продолжить;
		КонецЕсли;
		
		// Добавляем строку в табличную часть документа
		НоваяСтрока = ДокументДвижения.Реквизиты.Добавить();
		НоваяСтрока.ВидРеквизита = Выборка.ВидРеквизита;
		
		// Проверяем, какое действие указано в шаблоне
		// Сравниваем с предопределенными элементами справочника _Действия
		Если Выборка.СтартовоеДействие = Справочники._Действия.Установить Тогда
			// Устанавливаем значение из поля СтартовоеЗначениеРеквизита
			НоваяСтрока.ЗначениеРеквизита = Выборка.СтартовоеЗначениеРеквизита;
		ИначеЕсли Выборка.СтартовоеДействие = Справочники._Действия.ТекущаяДата Тогда
			// Устанавливаем значение как текущую дату сеанса
			НоваяСтрока.ЗначениеРеквизита = ТекущаяДатаСеанса();
		Иначе
			// возможно, это "НеИзменять" или другое, не требующее начального заполнения
			// В этом случае удалим только что добавленную строку
			ДокументДвижения.Реквизиты.Удалить(НоваяСтрока);
		КонецЕсли;
		
	КонецЦикла;
	
	
КонецПроцедуры 

Процедура СохранитьРеквизиты()
	
	ДокументДвижения = ЭтотОбъект.ДополнительныеСвойства.ДокументДвижения;

	// Перебираем строки таблицы СохраняемыеРеквизиты и сохраняю необходимые реквизиты
	Для Каждого Выборка Из ЭтотОбъект.ДополнительныеСвойства.СохраняемыеРеквизиты Цикл
		Если Выборка.Хранение <> Перечисления._СпособыХранениеРеквизитовКарточки.ВКарточке Тогда
			Продолжить; // сохранять нужно только те реквизиты, которые хранятся в карточке
		КонецЕсли;
		
		//Удаляю строки добавленные при старте, т.к. считаю, что старотовые значения менее приоритетны чем установленные вручную.
		ОтборПоискаУжеДобавленныхСтрок = Новый Структура("ВидРеквизита,УИД_Элемента",Выборка.ВидРеквизита,Выборка.УИД_Элемента);
		НайденныеСтроки = ДокументДвижения.Реквизиты.НайтиСтроки(ОтборПоискаУжеДобавленныхСтрок);
		Для Каждого НайденнаяСтрока из НайденныеСтроки Цикл
			ДокументДвижения.Реквизиты.Удалить(НайденнаяСтрока);
		КонецЦикла;
		
		// Добавляю строку со значением в табличную часть ДокументДвижения
		НоваяСтрока = ДокументДвижения.Реквизиты.Добавить();
		НоваяСтрока.ВидРеквизита = Выборка.ВидРеквизита;
		НоваяСтрока.ЗначениеРеквизита = Выборка.ЗначениеРеквизита;
		НоваяСтрока.УИД_Элемента = Выборка.УИД_Элемента;
	КонецЦикла;
	
КонецПроцедуры 

Процедура ПередЗаписью(Отказ)
	НачалоСтроки = "?";
	Разделитель="; ";
	ПредставлениВидаКрточки = НачалоСтроки;
	Для Каждого стрВидКарточки Из ЭтотОбъект.ВидыКарточки Цикл
		 ПредставлениВидаКарточки = ПредставлениВидаКрточки + Разделитель + СокрЛП(стрВидКарточки.ВидКарточки.Наименование);
	КонецЦикла;
	ПредставлениВидаКарточки = СтрЗаменить(ПредставлениВидаКарточки,НачалоСтроки+Разделитель,""); 
КонецПроцедуры


