//// что-то, где-то писал регулярные выражения
Функция ЭтоЦифра(Символ) 
 КодСимвола = КодСимвола(Символ); 
 Возврат (КодСимвола >= 48 И КодСимвола <= 57) 
КонецФункции
	
// Функция преобразования в Дату
Функция ПреобразоватьВДату(ПреобразуемоеЗначение) Экспорт
	ТипЗначения = ТипЗнч(ПреобразуемоеЗначение);
	Если ТипЗначения = Тип("Дата") Тогда
		Возврат ПреобразуемоеЗначение;
	ИначеЕсли ТипЗначения = Тип("Строка") и ПустаяСтрока(ПреобразуемоеЗначение) Тогда //Пустая строка
		Возврат Дата("01.01.0001 "+"00:00:00");
	ИначеЕсли ТипЗначения = Тип("Строка") и СтрДлина(ПреобразуемоеЗначение) = 10+1+8 Тогда //"01.01.2021 00:00:00"
		Возврат Дата(ПреобразуемоеЗначение);
	ИначеЕсли ТипЗначения = Тип("Строка") и СтрДлина(ПреобразуемоеЗначение) = 10 Тогда //"01.01.2021"
		Возврат Дата(ПреобразуемоеЗначение+" 00:00:00");
	ИначеЕсли ТипЗначения = Тип("Строка") и СтрДлина(ПреобразуемоеЗначение) = 8 Тогда //"00:00:00"
		Возврат Дата("01.01.0001 "+ПреобразуемоеЗначение);
	КонецЕсли;
	
	Возврат ПреобразуемоеЗначение;
КонецФункции


