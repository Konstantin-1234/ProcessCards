&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Владелец_Форма = Неопределено;
		Владелец_Список = Неопределено;
		Владелец_Поле = Неопределено;
		_НаКлиенте.ОпределитьВладельцаФормы(ЭтаФорма.ВладелецФормы,Владелец_Форма,Владелец_Список,Владелец_Поле);
		Если 
		   ( Владелец_Форма <> Неопределено И Владелец_Форма.ИмяФормы = "Справочник._Команды.Форма.ФормаЭлемента"
		   И Владелец_Список <> Неопределено И Владелец_Список.Имя = "ПравилаОбработкиКоманды" 
		   )
		Тогда
			Объект.Команда = Владелец_Форма.Объект.Ссылка;
			Объект.ВидКарточки = Владелец_Форма.Объект.ВидКарточки;
	    КонецЕсли;
    КонецЕсли;

	ОпределитьТипыЗначений();
    
КонецПроцедуры

