	Если Элемент.Имя="ДействияВидЗначения_Функция"	Тогда
		ТекущиеДанные.ЭтоВидЗначения_Значение = Ложь;
		ТекущиеДанные.ЭтоВидЗначения_Функция = ИСТИНА;
		ТекущиеДанные.ЭтоВидЗначения_ИзРеквизитаФункцРоли = Ложь;
		ТекущиеДанные.СпособВычисленияЗначения = ПредопределенноеЗначение("Перечисление._СпособыВычисленияЗначения.Функция");
