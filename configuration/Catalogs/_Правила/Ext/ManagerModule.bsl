Функция ПолучитьДоступныеПравила(Отбор,МенеджерВременныхТаблиц=Неопределено) Экспорт
	// 1. Подготовка Менеджера Временных Таблиц
	Если Не ТипЗнч(МенеджерВременныхТаблиц) = Тип("МенеджерВременныхТаблиц") Тогда
		МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	КонецЕсли;
	
	СформироватьМВТ_ДоступныеПравила(Отбор,МенеджерВременныхТаблиц);

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Правило
		|ИЗ
		|	ВТ_ДоступныеПравила КАК ВТ_ДоступныеПравила";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Результат = Новый Массив();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.Правило);
	КонецЦикла;
	
	Возврат Результат; 

КонецФункции

Функция ПолучитьДоступныеКоманды(Отбор,МенеджерВременныхТаблиц=Неопределено) Экспорт
	// 1. Подготовка Менеджера Временных Таблиц
	Если Не ТипЗнч(МенеджерВременныхТаблиц) = Тип("МенеджерВременныхТаблиц") Тогда
		МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	КонецЕсли;
	
	СформироватьМВТ_ДоступныеПравила(Отбор,МенеджерВременныхТаблиц);

	//2.
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ГруппаКоманд КАК ГруппаКоманд,
		|	Команда КАК Команда
		|ИЗ
		|	ВТ_ДоступныеПравила КАК ВТ_ДоступныеПравила";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	//3.
	Выборка = РезультатЗапроса.Выбрать();
	
	Результат = Новый Массив();
	Пока Выборка.Следующий() Цикл
		ЭлементВозврата = Новый Структура ("ГруппаКоманд,Команда", Выборка.ГруппаКоманд, Выборка.Команда);
		Результат.Добавить(ЭлементВозврата);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура СформироватьМВТ_ДоступныеПравила(Отбор, МенеджерВременныхТаблиц)	
	// 1. Подготовка Менеджера Временных Таблиц
	//Если Не ТипЗнч(МенеджерВременныхТаблиц) = Тип("МенеджерВременныхТаблиц") Тогда
	//	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	//КонецЕсли;

	
	//2.
	// Вызов функции ПолучитьСостояние, которая создаст ВТ_Реквизиты и ВТ_ЗначенияРеквизитов МенеджерВременныхТаблиц
	//РегистрыСведений._СостояниеКарточек.ПолучитьСостояние(, Отбор, МенеджерВременныхТаблиц);
	
	//3. Подготовка запроса и его выполнение
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	//+Временный код
	// Получение состояния карточек желательно сделать с помощью РегистрыСведений._СостояниеКарточек.ПолучитьСостояние()
	
	// Проверка обязательного параметра, нужно настроить возможность проверки массива карточек
	Если ЗначениеЗаполнено(Отбор.Карточка) Тогда
	Иначе
		ВызватьИсключение "Параметр ""Отбор"" должен содержать заполненное свойство ""Карточка"".";
	КонецЕсли;
	// заполняю параметр МассивКарточек
	МассивКарточекДляЗапроса = Новый Массив();
	МассивКарточекДляЗапроса.Добавить(Отбор.Карточка);
	Запрос.УстановитьПараметр("МассивКарточек", МассивКарточекДляЗапроса);

	// вычисление значения параметра ВидаКарточки. Важно: исхожу из положения,одно значение. слодовательно все карточки должны быть одного вида
	Запрос.УстановитьПараметр("ВидКарточки", Отбор.Карточка.ВидКарточки);

	// определение параметра проверки множественных реквизитов (по умолчанию Ложь = поведение как раньше)
	Запрос.УстановитьПараметр("ОбрабатыватьМножественныеРеквизитыКакИ", Ложь);

	//-Временный код
	
	Запрос.Текст =
		"
		// ЭТАП 1: Получаю Виды реквизитов, значения котрых требуется анализировать для поиска правил вида карточки
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	_ПравилаУсловия.ВидРеквизита КАК ВидРеквизита,
		|	_ПравилаУсловия.ВидРеквизитаДополнение КАК ВидРеквизитаДополнение
		|ПОМЕСТИТЬ ВТ_Реквизиты
		|ИЗ
		|	Справочник._Правила.ВидыКарточек КАК _ПравилаВидыКарточек
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник._Правила.Условия КАК _ПравилаУсловия
		|		ПО (_ПравилаВидыКарточек.ВидКарточки = &ВидКарточки
		|			И _ПравилаВидыКарточек.Ссылка = _ПравилаУсловия.Ссылка)
		|ГДЕ
		|	_ПравилаВидыКарточек.ВидКарточки = &ВидКарточки
		|;
		|
		// ЭТАП 2: Проверяемые карточки
		|ВЫБРАТЬ
		|	_Карточки.Ссылка КАК Карточка
		|ПОМЕСТИТЬ ВТ_Карточки
		|ИЗ
		|	Справочник._Карточки КАК _Карточки
		|ГДЕ
		|	_Карточки.Ссылка В(&МассивКарточек)
		|;
		|
		// ЭТАП 3: Умножаю реквизиты на отобранные карточки, что бы был NULL, если значение реквизита не указано. Это необходимо, что бы проверка каждого реквизита гарантированно случилась.
		|ВЫБРАТЬ
		|	ВТ_Карточки.Карточка КАК Карточка,
		|	ВТ_Реквизиты.ВидРеквизита КАК ВидРеквизита,
		|	ВТ_Реквизиты.ВидРеквизитаДополнение КАК ВидРеквизитаДополнение
		|ПОМЕСТИТЬ ВТ_КарточкиРеквизиты
		|ИЗ
		|	ВТ_Карточки КАК ВТ_Карточки
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Реквизиты КАК ВТ_Реквизиты
		|		ПО (ИСТИНА)
		|;
		|
		// ЭТАП 4.1: Получаю значения реквизитов карточек для последующей проверки.
		|ВЫБРАТЬ
		|	ВТ_КарточкиРеквизиты.Карточка КАК Карточка,
		|	ВТ_КарточкиРеквизиты.ВидРеквизита КАК ВидРеквизита,
		|	ВТ_КарточкиРеквизиты.ВидРеквизитаДополнение КАК ВидРеквизитаДополнение,
		|	Регистр.ЗначениеРеквизита КАК СвязаннаяКарточка,
		|	ВЫБОР КОГДА ВТ_КарточкиРеквизиты.ВидРеквизитаДополнение = ЗНАЧЕНИЕ(ПланВидовХарактеристик._ВидыРеквизитов.ПустаяСсылка) ТОГДА Регистр.ЗначениеРеквизита ИНАЧЕ NULL КОНЕЦ КАК ЗначениеРеквизита,
		|	Регистр.УИД_Элемента КАК УИД_Элемента // <<<ИЗМ>>> добавлено поле УИД_Элемента из регистра
		|ПОМЕСТИТЬ ВТ_ЗначенияРеквизитовКарточек_1
		|ИЗ
		|	ВТ_КарточкиРеквизиты КАК ВТ_КарточкиРеквизиты
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений._СостояниеКарточек.СрезПоследних(
		|				,
		|				Карточка В (ВЫБРАТЬ Карточка ИЗ ВТ_Карточки)
		// Можно оптимизировать добавив отбор по виду реквизита на основании таблицы ВТ_Реквизиты
		|		) КАК Регистр
		|		ПО ВТ_КарточкиРеквизиты.Карточка = Регистр.Карточка
		|		 И ВТ_КарточкиРеквизиты.ВидРеквизита = Регистр.ВидРеквизита
		|ГДЕ // <<<ИЗМ>>> новый ГДЕ: учитываем только активные элементы; ЕСТЬ NULL сохраняет строку, когда значения в регистре нет вовсе (прежняя логика ЭТАПА 3)
		|	Регистр.ЗначениеАктивно = ИСТИНА ИЛИ Регистр.ЗначениеАктивно ЕСТЬ NULL // <<<ИЗМ>>>
		|;
		|
		// ЭТАП 4.2: Получаю значения реквизитов связанных карточек.
		|ВЫБРАТЬ
		|	ВТ_ЗначенияРеквизитовКарточек_1.Карточка КАК Карточка,
		|	ВТ_ЗначенияРеквизитовКарточек_1.ВидРеквизита КАК ВидРеквизита,
		|	ВТ_ЗначенияРеквизитовКарточек_1.ВидРеквизитаДополнение КАК ВидРеквизитаДополнение,
		|	ВТ_ЗначенияРеквизитовКарточек_1.УИД_Элемента КАК УИД_Элемента, // <<<ИЗМ>>> пронесён УИД элемента текущей карточки (в т.ч. множественной ссылки)
		|	Регистр.УИД_Элемента КАК УИД_ЭлементаДополнение, // <<<ИЗМ>>> добавлено поле УИД_ЭлементаДополнение из регистра связанной карточки
		|	Регистр.ЗначениеРеквизита КАК ЗначениеРеквизита
		|ПОМЕСТИТЬ ВТ_ЗначенияРеквизитовКарточек_2
		|ИЗ
		|	ВТ_ЗначенияРеквизитовКарточек_1 КАК ВТ_ЗначенияРеквизитовКарточек_1
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений._СостояниеКарточек.СрезПоследних(
		|				,
		|				Карточка В (ВЫБРАТЬ РАЗЛИЧНЫЕ СвязаннаяКарточка ИЗ ВТ_ЗначенияРеквизитовКарточек_1)
		// Можно оптимизировать добавив отбор по виду реквизита на основании таблицы ВТ_Реквизиты
		|		) КАК Регистр
		|		ПО ВТ_ЗначенияРеквизитовКарточек_1.СвязаннаяКарточка = Регистр.Карточка
		|		 И ВТ_ЗначенияРеквизитовКарточек_1.ВидРеквизитаДополнение = Регистр.ВидРеквизита // Регистр.ВидРеквизита - обязателен к заполнению, поэтому для пустых ВидРеквизитаДополнение не появится
		|ГДЕ
		|	ВТ_ЗначенияРеквизитовКарточек_1.ВидРеквизитаДополнение <> ЗНАЧЕНИЕ(ПланВидовХарактеристик._ВидыРеквизитов.ПустаяСсылка)
		|	И (Регистр.ЗначениеАктивно = ИСТИНА ИЛИ Регистр.ЗначениеАктивно ЕСТЬ NULL) // <<<ИЗМ>>> только активные элементы связанной карточки, NULL сохраняет прежнюю логику
		|;
		|
		// ЭТАП 4.3: Объединяю таблицы значений реквизитов карточки и значений реквизитов связанных карточек
		|ВЫБРАТЬ
		|	ВТ_ЗначенияРеквизитовКарточек_1.Карточка КАК Карточка,
		|	ВТ_ЗначенияРеквизитовКарточек_1.ВидРеквизита КАК ВидРеквизита,
		|	ВТ_ЗначенияРеквизитовКарточек_1.ВидРеквизитаДополнение КАК ВидРеквизитаДополнение,
		|	ВТ_ЗначенияРеквизитовКарточек_1.УИД_Элемента КАК УИД_Элемента, // <<<ИЗМ>>> поле УИД_Элемента в итоговой таблице
		|	NULL КАК УИД_ЭлементаДополнение, // <<<ИЗМ>>> для собственных реквизитов текущей карточки дополнения нет
		|	ВТ_ЗначенияРеквизитовКарточек_1.ЗначениеРеквизита КАК ЗначениеРеквизита
		|ПОМЕСТИТЬ ВТ_ЗначенияРеквизитовКарточек
		|ИЗ
		|	ВТ_ЗначенияРеквизитовКарточек_1 КАК ВТ_ЗначенияРеквизитовКарточек_1
		|ГДЕ
		|	ВТ_ЗначенияРеквизитовКарточек_1.ВидРеквизитаДополнение = ЗНАЧЕНИЕ(ПланВидовХарактеристик._ВидыРеквизитов.ПустаяСсылка)
		|ОБЪЕДИНИТЬ ВСЕ
		|ВЫБРАТЬ
		|	ВТ_ЗначенияРеквизитовКарточек_2.Карточка КАК Карточка,
		|	ВТ_ЗначенияРеквизитовКарточек_2.ВидРеквизита КАК ВидРеквизита,
		|	ВТ_ЗначенияРеквизитовКарточек_2.ВидРеквизитаДополнение КАК ВидРеквизитаДополнение,
		|	ВТ_ЗначенияРеквизитовКарточек_2.УИД_Элемента КАК УИД_Элемента, // <<<ИЗМ>>> поле УИД_Элемента в итоговой таблице
		|	ВТ_ЗначенияРеквизитовКарточек_2.УИД_ЭлементаДополнение КАК УИД_ЭлементаДополнение, // <<<ИЗМ>>> поле УИД_ЭлементаДополнение в итоговой таблице
		|	ВТ_ЗначенияРеквизитовКарточек_2.ЗначениеРеквизита КАК ЗначениеРеквизита
		|ИЗ
		|	ВТ_ЗначенияРеквизитовКарточек_2 КАК ВТ_ЗначенияРеквизитовКарточек_2
		|ГДЕ
		// Проверка на ПланВидовХарактеристик._ВидыРеквизитов.ПустаяСсылка уже сделана на этапе 4.2, но пусть будет здесь для читаемости кода
		|	ВТ_ЗначенияРеквизитовКарточек_2.ВидРеквизитаДополнение <> ЗНАЧЕНИЕ(ПланВидовХарактеристик._ВидыРеквизитов.ПустаяСсылка)
		|;
		|
		// ЭТАП 5: Подготавливаю атомарные условия, для каждой строки условия должна быть ИСТИНА и для срвнения_1 и для Сравнения_2.
		|ВЫБРАТЬ
		|	_ПравилаУсловия.Ссылка КАК Правило,
		|	_ПравилаУсловия.НомерСтроки КАК НомерСтроки,
		|	_ПравилаУсловия.Группа КАК Группа,
		|	_ПравилаУсловия.ВидРеквизита КАК ВидРеквизита,
		|	_ПравилаУсловия.ВидРеквизитаДополнение КАК ВидРеквизитаДополнение,
		|	1 КАК Чек,
		|	_ПравилаУсловия.Сравнение_1 КАК Сравнение,
		|	_ПравилаУсловия.ЗначениеРеквизита_1 КАК ЗначениеРеквизита
		|ПОМЕСТИТЬ ВТ_ЗначенияУсловий
		|ИЗ
		|	Справочник._Правила.Условия КАК _ПравилаУсловия
		|ГДЕ
		|	_ПравилаУсловия.Ссылка.Команда = &Команда
		|	И _ПравилаУсловия.Сравнение_1 <> ЗНАЧЕНИЕ(Перечисление._ВариантыСравнения.НеИспользовать)
		|ОБЪЕДИНИТЬ ВСЕ
		|ВЫБРАТЬ
		|	_ПравилаУсловия.Ссылка,
		|	_ПравилаУсловия.НомерСтроки,
		|	_ПравилаУсловия.Группа,
		|	_ПравилаУсловия.ВидРеквизита,
		|	_ПравилаУсловия.ВидРеквизитаДополнение КАК ВидРеквизитаДополнение,
		|	2,
		|	_ПравилаУсловия.Сравнение_2,
		|	_ПравилаУсловия.ЗначениеРеквизита_2
		|ИЗ
		|	Справочник._Правила.Условия КАК _ПравилаУсловия
		|ГДЕ
		|	_ПравилаУсловия.Ссылка.Команда = &Команда
		|	И _ПравилаУсловия.Сравнение_2 <> ЗНАЧЕНИЕ(Перечисление._ВариантыСравнения.НеИспользовать)
		|	И _ПравилаУсловия.Сравнение_2 <> ЗНАЧЕНИЕ(Перечисление._ВариантыСравнения.ПустаяСсылка)
		|;
		|
		// ЭТАП 6: Подготавливаю данные для атомарных условий.
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТ_ЗначенияРеквизитовКарточек.Карточка КАК Карточка,
		|	ВТ_ЗначенияРеквизитовКарточек.ЗначениеРеквизита КАК ЗначениеКарточки,
		|	ВТ_ЗначенияУсловий.ЗначениеРеквизита КАК ЗначениеПроверки,
		|	ВТ_ЗначенияУсловий.Сравнение КАК Сравнение,
		|	ВТ_ЗначенияУсловий.Правило КАК Правило,
		|	ВТ_ЗначенияУсловий.Группа КАК Группа,
		|	ВТ_ЗначенияУсловий.ВидРеквизита КАК ВидРеквизита,
		|	ВТ_ЗначенияУсловий.ВидРеквизитаДополнение КАК ВидРеквизитаДополнение,
		|	ВТ_ЗначенияУсловий.НомерСтроки КАК НомерСтроки,
		|	ВТ_ЗначенияУсловий.Чек КАК Чек,
		|	ВТ_ЗначенияРеквизитовКарточек.УИД_Элемента КАК УИД_Элемента, // <<<ИЗМ>>> пронесён УИД элемента
		|	ВТ_ЗначенияРеквизитовКарточек.УИД_ЭлементаДополнение КАК УИД_ЭлементаДополнение // <<<ИЗМ>>> пронесён УИД элемента дополнения
		|ПОМЕСТИТЬ ВТ_ПроверяемыеСеты
		|ИЗ
		|	ВТ_ЗначенияРеквизитовКарточек КАК ВТ_ЗначенияРеквизитовКарточек
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ЗначенияУсловий КАК ВТ_ЗначенияУсловий
		|		ПО ВТ_ЗначенияРеквизитовКарточек.ВидРеквизита = ВТ_ЗначенияУсловий.ВидРеквизита
		|		И ВТ_ЗначенияРеквизитовКарточек.ВидРеквизитаДополнение = ВТ_ЗначенияУсловий.ВидРеквизитаДополнение
		|;
		|
		// ЭТАП 7: Вычисляем результат каждой атомарной проверки (1 = Истина, 0 = Ложь)
		|ВЫБРАТЬ
		|	Карточка, ЗначениеКарточки, ЗначениеПроверки, Правило, Группа, ВидРеквизита, ВидРеквизитаДополнение, НомерСтроки, Чек, УИД_Элемента, УИД_ЭлементаДополнение, // <<<ИЗМ>>> в список полей добавлены УИД_Элемента, УИД_ЭлементаДополнение
		|	ВЫБОР
		|		КОГДА(Сравнение = ЗНАЧЕНИЕ(Перечисление._ВариантыСравнения.Равно) И ЗначениеКарточки = ЗначениеПроверки) ИЛИ
		|		     (Сравнение = ЗНАЧЕНИЕ(Перечисление._ВариантыСравнения.Больше) И ЗначениеКарточки > ЗначениеПроверки) ИЛИ
		|		     (Сравнение = ЗНАЧЕНИЕ(Перечисление._ВариантыСравнения.Меньше) И ЗначениеКарточки < ЗначениеПроверки) ИЛИ
		|		     (Сравнение = ЗНАЧЕНИЕ(Перечисление._ВариантыСравнения.БольшеРавно) И ЗначениеКарточки >= ЗначениеПроверки) ИЛИ
		|		     (Сравнение = ЗНАЧЕНИЕ(Перечисление._ВариантыСравнения.МеньшеРавно) И ЗначениеКарточки <= ЗначениеПроверки) ИЛИ
		|		     (Сравнение = ЗНАЧЕНИЕ(Перечисление._ВариантыСравнения.Заполнено) И (НЕ ЗначениеКарточки ЕСТЬ NULL И ЗначениеКарточки <> Неопределено)) ИЛИ
		|		     (Сравнение = ЗНАЧЕНИЕ(Перечисление._ВариантыСравнения.НеЗаполнено) И (ЗначениеКарточки ЕСТЬ NULL ИЛИ ЗначениеКарточки = Неопределено)) ИЛИ
		|			 Сравнение = ЗНАЧЕНИЕ(Перечисление._ВариантыСравнения.ПустаяСсылка) ИЛИ    // откличено на этапе 5, но всё равно пусть здесь будет эта проверка, что бы не потерялась
		|			 Сравнение = ЗНАЧЕНИЕ(Перечисление._ВариантыСравнения.НеИспользовать) // откличено на этапе 5, но всё равно пусть здесь будет эта проверка, что бы не потерялась
		|		ТОГДА 1 ИНАЧЕ 0
		|	КОНЕЦ КАК РезультатПроверки
		|ПОМЕСТИТЬ ВТ_РезультатыПроверок
		|ИЗ
		|	ВТ_ПроверяемыеСеты
		|;
		|
		// <<<НОВЫЙ БЛОК>>> ЭТАП 7.1 (множественные реквизиты ТЕКУЩЕЙ карточки, включая множественную ссылку на связанную):
		// схлопываем элементы УИД_Элемента. ИСТИНА = должны пройти ВСЕ элементы (МИНИМУМ), ЛОЖЬ = достаточно ЛЮБОГО (МАКСИМУМ).
		|ВЫБРАТЬ
		|	Карточка, Правило, Группа, ВидРеквизита, ВидРеквизитаДополнение, НомерСтроки, Чек, УИД_ЭлементаДополнение,
		|	ВЫБОР КОГДА &ОбрабатыватьМножественныеРеквизитыКакИ = ИСТИНА ТОГДА МИНИМУМ(РезультатПроверки) ИНАЧЕ МАКСИМУМ(РезультатПроверки) КОНЕЦ КАК РезультатПроверки
		|ПОМЕСТИТЬ ВТ_РезультатыПроверокЭлементовТекущей
		|ИЗ
		|	ВТ_РезультатыПроверок
		|СГРУППИРОВАТЬ ПО Карточка, Правило, Группа, ВидРеквизита, ВидРеквизитаДополнение, НомерСтроки, Чек, УИД_ЭлементаДополнение
		|;
		|
		// ЭТАП 7.2 (множественные реквизиты СВЯЗАННЫХ карточек):
		// схлопываем элементы УИД_ЭлементаДополнение с той же логикой параметра. Проверка параметра выполнена выделено от этапа 7.1.
		|ВЫБРАТЬ
		|	Карточка, Правило, Группа, ВидРеквизита, ВидРеквизитаДополнение, НомерСтроки, Чек,
		|	ВЫБОР КОГДА &ОбрабатыватьМножественныеРеквизитыКакИ = ИСТИНА ТОГДА МИНИМУМ(РезультатПроверки) ИНАЧЕ МАКСИМУМ(РезультатПроверки) КОНЕЦ КАК РезультатПроверки
		|ПОМЕСТИТЬ ВТ_РезультатыПроверокЭлементовСвязанных
		|ИЗ
		|	ВТ_РезультатыПроверокЭлементовТекущей
		|СГРУППИРОВАТЬ ПО Карточка, Правило, Группа, ВидРеквизита, ВидРеквизитаДополнение, НомерСтроки, Чек
		|;
		// <<<КОНЕЦ НОВОГО БЛОКА>>>
		|
		// ЭТАП 8: (Уровень строки: И) Вычисляю результат проверки строк.
		// Строка считается выполненной, если все чеки для неё выполнены (МИНИМУМ = 1).
		|ВЫБРАТЬ
		|	Карточка, Правило, Группа, ВидРеквизита, ВидРеквизитаДополнение, НомерСтроки,
		|	МИНИМУМ(РезультатПроверки) КАК РезультатПроверки
		|ПОМЕСТИТЬ ВТ_РезультатыПроверкиСтрок
		|ИЗ
		|	ВТ_РезультатыПроверокЭлементовСвязанных // <<<ИЗМ>>> источник изменён с ВТ_РезультатыПроверок на ВТ_РезультатыПроверокЭлементовСвязанных
		|СГРУППИРОВАТЬ ПО Карточка, Правило, Группа, ВидРеквизита, ВидРеквизитаДополнение, НомерСтроки
		|;
		|
		// ЭТАП 9 (Уровень вида реквизита: ИЛИ): Вычисляю результат проверки реквизитов.
		// Реквизит считается выполненным, если для него имеется хотя бы одна выполненная строка (МАКСИМУМ = 1).
		|ВЫБРАТЬ
		|	Карточка, Правило, Группа, ВидРеквизита, ВидРеквизитаДополнение,
		|	МАКСИМУМ(РезультатПроверки) КАК РезультатПроверки
		|ПОМЕСТИТЬ ВТ_РезультатыПроверкиРеквизитов
		|ИЗ
		|	ВТ_РезультатыПроверкиСтрок
		|СГРУППИРОВАТЬ ПО Карточка, Правило, Группа, ВидРеквизита, ВидРеквизитаДополнение
		|;
		|
		// ЭТАП 10 (Уровень группы: И): Вычисляю результат проверки группы.
		// Группа считается выполненной, если все её реквизиты выполнены (МИНИМУМ = 1).
		// ЕСТЬNULL добавлен на случай пустой группы, чтобы она считалась невыполненной (0).
		|ВЫБРАТЬ
		|	Карточка, Правило, Группа,
		|	ЕСТЬNULL(МИНИМУМ(РезультатПроверки), 0) КАК РезультатПроверки
		|ПОМЕСТИТЬ ВТ_РезультатыПроверкиГрупп
		|ИЗ
		|	ВТ_РезультатыПроверкиРеквизитов
		|СГРУППИРОВАТЬ ПО Карточка, Правило, Группа
		|;
		|
		// ЭТАП 11 (Уровень правила: ИЛИ между группами): Вычисляю результат проверки правила.
		// Правило считается выполненным, если выполнена хотя бы одна группа (МАКСИМУМ = 1).
		|ВЫБРАТЬ
		|	Карточка, Правило,
		|	МАКСИМУМ(РезультатПроверки) КАК РезультатПроверки
		|ПОМЕСТИТЬ ВТ_РезультатыПроверкиПравил
		|ИЗ
		|	ВТ_РезультатыПроверкиГрупп
		|СГРУППИРОВАТЬ ПО Карточка, Правило
		|;
		|
		// ЭТАП 12: Отбираю доступные правила (те, где итоговый результат проверки = 1).
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Карточка КАК Карточка,
		|	Правило КАК Правило
		|ПОМЕСТИТЬ ВТ_ВыполненыеПравила_с_Карточками
		|ИЗ
		|	ВТ_РезультатыПроверкиПравил
		|ГДЕ РезультатПроверки = 1
		|;
		|
		// ЭТАП 13: Финальная выборка доступных правил и их команд.
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Правило КАК Правило,
		|	Правило.Команда КАК Команда,
		|	Правило.Команда.Группа КАК ГруппаКоманд
		|ПОМЕСТИТЬ ВТ_ДоступныеПравила
		|ИЗ
		|	ВТ_ВыполненыеПравила_с_Карточками
		|";

		
	Если Отбор.Свойство("Команда") И ЗначениеЗаполнено(Отбор.Команда) Тогда
		Запрос.УстановитьПараметр("Команда", Отбор.Команда);
	Иначе
		//отсутствует отбор для команды, удаляю эту проверку из текста запроса
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"_ПравилаУсловия.Ссылка.Команда = &Команда","ИСТИНА"); 
	КонецЕсли;
	
	// Выполнение запроса, которое и создаст все необходимые ВТ в менеджере.
	Запрос.Выполнить();
	
КонецПроцедуры



