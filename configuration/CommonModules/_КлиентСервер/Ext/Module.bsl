//--------------------------------------------------------
// Функция обходит строки (элементы) в ТаблицеПодобныйОбъект, находит те, 
// где указанные колонки равняются значениям из отбора, и возвращает их в виде массива.
//
// Параметры:
//  ТаблицеПодобныйОбъект - ТаблицаЗначений, ТабличнаяЧасть или Массив Структур.
//  Отбор - Структура или Соответствие с условиями отбора.
//
// Возвращаемое значение:
//  Массив - найденные строки (элементы), удовлетворяющие всем условиям отбора.
//
Функция НайтиСтрокиВТЗ(ТаблицеПодобныйОбъект, Отбор) Экспорт
	
	// 1. Подготовка отбора: приведение к Соответствию
	Если ТипЗнч(Отбор) = Тип("Соответствие") Тогда
		ОтборПодготовленный = Отбор;
	ИначеЕсли ТипЗнч(Отбор) = Тип("Структура") Тогда 
		ОтборПодготовленный = Новый Соответствие;
		// Переносим свойства из Структуры в Соответствие
		Для Каждого ЭлементОтбора Из Отбор Цикл
			ОтборПодготовленный.Вставить(ЭлементОтбора.Ключ, ЭлементОтбора.Значение);
		КонецЦикла;
	Иначе 
		ВызватьИсключение("НайтиСтрокиВТЗ: Неверный тип параметра 'Отбор'. Ожидается Структура или Соответствие.");
		Возврат Неопределено;
	КонецЕсли;
	
	РезультатМассивом = Новый Массив;
	
	// 2. Обход строк коллекции
	Для Каждого СтрТЗ Из ТаблицеПодобныйОбъект Цикл 

		ЭтаСтрокаСоответствуетУсловию = Истина;
		
		// 3. Проверка условий отбора для текущей строки
		Для Каждого ЭлементОтбора Из ОтборПодготовленный Цикл 
			
			ТекущееЗначение = СтрТЗ[ЭлементОтбора.Ключ];
			
			Если ТекущееЗначение <> ЭлементОтбора.Значение Тогда
				ЭтаСтрокаСоответствуетУсловию = Ложь;
				Прервать; // Оптимизация: нет смысла проверять остальные условия, если одно уже не совпало (логическое И)
			КонецЕсли;
			
		КонецЦикла;

		// 4. Формирование результата
		Если ЭтаСтрокаСоответствуетУсловию Тогда
			РезультатМассивом.Добавить(СтрТЗ);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат РезультатМассивом;
		
КонецФункции