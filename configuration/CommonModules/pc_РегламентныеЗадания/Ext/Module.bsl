Процедура ВыполнениеРегламентныхКоманд_ВРазработке() Экспорт
	
	// 1. Получить команды, у которых АвтоОбработка = Истина
	Запрос = Новый Запрос;
	Запрос.Текст = "
		|ВЫБРАТЬ
		|	Ссылка,
		|	ВидКарточки
		|ИЗ
		|	Справочник._Команды
		|ГДЕ
		|	АвтоОбработка = &Истина";
	Запрос.УстановитьПараметр("Истина", Истина);
	
	ВыборкаКоманд = Запрос.Выполнить().Выбрать();
	
	// 2. Обработка команд в цикле
	Пока ВыборкаКоманд.Следующий() Цикл
		Команда = ВыборкаКоманд.Ссылка;
		
		//// Проверяем количество строк в ТЧ ФункциональныеРоли
		//Если Команда.ФункциональныеРоли.Количество() = 0 Тогда
		//	
		//	// 2.1 Для тех команд, у которых количество ФункциональныхРолей = 0
		//	ОтборПоискаПравил = Новый Структура;
		//	ОтборПоискаПравил.Вставить("Команды", Новый Массив());
		//	ОтборПоискаПравил.Команды.Добавить(Команда);
		//	// Отбор по карточкам не устанавливаем, карточки найдутся самостоятельно
		//	ОтборПоискаПравил.Вставить("ВидКарточки", Команда.ВидКарточки); 
		//	ОтборПоискаПравил.Вставить("Карточки", Новый Массив); 
		//	
		//	Отказ = Ложь;
		//	Справочники._Команды.ВыполнитьКоманду(Отказ, ОтборПоискаПравил);
		//	
		//Иначе
			
			// 2.2 Для тех команд, у которых количество ФункциональныхРолей > 0

			//Закоментировал проверку. т.к. пусто в Команда.ВидКарточки - это ошибка хранения.
			//Прятать ошибки хранения - это ВРЕДИТЕЛЬСТВО. 
			//В рабочей базе ошибка должна фиксироваться в логе для последующего исправления.
			//Если Не ЗначениеЗаполнено(Команда.ВидКарточки) Тогда
			//	Продолжить;
			//КонецЕсли;
			
			// 2.2.1 Получить список карточек, где АвтоОбработка = Истина
			ОтборСостояния = Новый Соответствие();
			ОтборСостояния.Вставить("ВидКарточки", Команда.ВидКарточки);
			ОтборСостояния.Вставить(ПланыВидовХарактеристик._ВидыРеквизитов.АвтоОбработка, ИСТИНА);

			ФильтрВидовРеквизитов = Новый Массив;
			ФильтрВидовРеквизитов.Добавить(ПланыВидовХарактеристик._ВидыРеквизитов.Ссылка);
			ФильтрВидовРеквизитов.Добавить(ПланыВидовХарактеристик._ВидыРеквизитов.АвтоОбработка);
			
			Состояния = РегистрыСведений._СостояниеКарточек.ПолучитьСостояние(ОтборСостояния, ФильтрВидовРеквизитов);
			
			СписокКарточек = Новый Массив;
			Для Каждого Состояние Из Состояния Цикл
				Если Состояние.ВидРеквизита = ПланыВидовХарактеристик._ВидыРеквизитов.Ссылка Тогда
					СписокКарточек.Добавить(Состояние.Карточка);
				КонецЕсли;
			КонецЦикла;
			
			// 2.2.2 и 2.2.3 Для каждой карточки получить функциональные роли и выполнить команду
			Для Каждого Карточка Из СписокКарточек Цикл
				
				// Получаем полное состояние карточки для определения функциональных ролей
				ОтборПолногоСостояния = Новый Структура("Карточка, ВидКарточки", Карточка, Команда.ВидКарточки);
				ПолноеСостояние = РегистрыСведений._СостояниеКарточек.ПолучитьСостояние(ОтборПолногоСостояния);
				
				МассивРолей = Новый Массив;
				
				// Всегда добавляем ОсновнуюФР
				ОтборОсновнойРоли = Новый Структура;
				ОтборОсновнойРоли.Вставить("ФункциональнаяРоль", Справочники._ФункциональныеРоли.ОсновнаяФР);
				МассивОсновных = Новый Массив;
				МассивОсновных.Добавить(Карточка);
				ОтборОсновнойРоли.Вставить("Карточки", МассивОсновных);
				ОтборОсновнойРоли.Вставить("ПроверятьКакИ", Истина);
				МассивРолей.Добавить(ОтборОсновнойРоли);
				
				// Получаем источники функциональных ролей для команды
				ЗапросИсточников = Новый Запрос;
				ЗапросИсточников.Текст = "
					|ВЫБРАТЬ
					|    ФункциональнаяРоль,
					|    ВидРеквизита,
					|    ВидРеквизитаДополнение
					|ИЗ
					|    РегистрСведений._ИсточникиФункциональныхРолей
					|ГДЕ
					|    Команда = &Команда";
				ЗапросИсточников.УстановитьПараметр("Команда", Команда);
				ВыборкаИсточников = ЗапросИсточников.Выполнить().Выбрать();
				
				Пока ВыборкаИсточников.Следующий() Цикл
					ФункциональнаяРоль = ВыборкаИсточников.ФункциональнаяРоль;
					ВидРеквизита = ВыборкаИсточников.ВидРеквизита;
					ВидРеквизитаДополнение = ВыборкаИсточников.ВидРеквизитаДополнение;
					
					ЗначениеРоли = Неопределено;
					
					Для Каждого СтрСостояния Из ПолноеСостояние Цикл
						Если СтрСостояния.ВидРеквизита = ВидРеквизита И СтрСостояния.ЗначениеАктивно Тогда
							Если Не ЗначениеЗаполнено(ВидРеквизитаДополнение) Тогда
								ЗначениеРоли = СтрСостояния.ЗначениеРеквизита;
							ИначеЕсли ТипЗнч(СтрСостояния.ЗначениеРеквизита) = Тип("СправочникСсылка._Карточки") Тогда
								СвязаннаяКарточка = СтрСостояния.ЗначениеРеквизита;
								Если СвязаннаяКарточка.ВидыКарточки.Количество() > 0 Тогда
									ВидСвязаннойКарточки = СвязаннаяКарточка.ВидыКарточки[0].ВидКарточки;
									ОтборСвязанной = Новый Структура("Карточка, ВидКарточки", СвязаннаяКарточка, ВидСвязаннойКарточки);
									СостояниеСвязанной = РегистрыСведений._СостояниеКарточек.ПолучитьСостояние(ОтборСвязанной);
									Для Каждого СтрСвязанной Из СостояниеСвязанной Цикл
										Если СтрСвязанной.ВидРеквизита = ВидРеквизитаДополнение И СтрСвязанной.ЗначениеАктивно Тогда
											ЗначениеРоли = СтрСвязанной.ЗначениеРеквизита;
											Прервать;
										КонецЕсли;
									КонецЦикла;
								КонецЕсли;
							КонецЕсли;
							Прервать;
						КонецЕсли;
					КонецЦикла;
					
					Если ЗначениеЗаполнено(ЗначениеРоли) Тогда
						ОтборДопРоли = Новый Структура;
						ОтборДопРоли.Вставить("ФункциональнаяРоль", ФункциональнаяРоль);
						МассивЗначений = Новый Массив;
						МассивЗначений.Добавить(ЗначениеРоли);
						ОтборДопРоли.Вставить("Карточки", МассивЗначений);
						ОтборДопРоли.Вставить("ПроверятьКакИ", Истина);
						МассивРолей.Добавить(ОтборДопРоли);
					КонецЕсли;
				КонецЦикла;
				
				ОтборПоискаПравил = Новый Структура;
				ОтборПоискаПравил.Вставить("Команды", Новый Массив);
				ОтборПоискаПравил.Команды.Добавить(Команда);
				ОтборПоискаПравил.Вставить("Карточки", МассивРолей);
				//ОтборПоискаПравил.Вставить("ВидКарточки", Команда.ВидКарточки); //Временное решение, процедура ВыполнитьКоманду должна сама вычислять ВидКарточки, если получила Команды
				
				Отказ = Ложь;
				Справочники._Команды.ВыполнитьКоманду(Отказ, ОтборПоискаПравил);
				
			КонецЦикла;
			
		//КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры