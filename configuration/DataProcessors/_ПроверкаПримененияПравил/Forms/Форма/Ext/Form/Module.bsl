&НаКлиенте
Процедура Проверить(Команда)
    
    Если Не ЗначениеЗаполнено(Объект.Карточка) Или Не ЗначениеЗаполнено(Объект.Правило) Тогда
        Сообщить("Для выполнения проверки заполните реквизиты ""Карточка"" и ""Правило"".");
        Возврат;
    КонецЕсли;
    
    ОчиститьСообщения();
    ПроверитьНаСервере();
    
КонецПроцедуры

&НаСервере
Процедура ПроверитьНаСервере()
    
    // 1. Формируем структуру отбора
    Отбор = Новый Структура;
    Отбор.Вставить("ВидКарточки", Объект.Правило.ВидКарточки);
    
    МассивКарточек = Новый Массив;
    
    // Добавляем основную проверяемую карточку (Служебная роль ОсновнаяФР)
    СтруктураОсновнойФР = Новый Структура;
    СтруктураОсновнойФР.Вставить("ФункциональнаяРоль", Справочники._ФункциональныеРоли.ОсновнаяФР);
    
    МассивОсновной = Новый Массив;
    МассивОсновной.Добавить(Объект.Карточка);
    СтруктураОсновнойФР.Вставить("Карточки", МассивОсновной);
    СтруктураОсновнойФР.Вставить("ПроверятьКакИ", Истина);
    
    МассивКарточек.Добавить(СтруктураОсновнойФР);
    
    // Добавляем связанные карточки других функциональных ролей из таблицы на форме
    Для Каждого СтрокаРоли Из Объект.ТаблицаРолей Цикл
        Если Не ЗначениеЗаполнено(СтрокаРоли.ФункциональнаяРоль) Или Не ЗначениеЗаполнено(СтрокаРоли.Карточка) Тогда
            Продолжить;
        КонецЕсли;
        
        СтруктураФР = Новый Структура;
        СтруктураФР.Вставить("ФункциональнаяРоль", СтрокаРоли.ФункциональнаяРоль);
        
        МассивДоп = Новый Массив;
        МассивДоп.Добавить(СтрокаРоли.Карточка);
        СтруктураФР.Вставить("Карточки", МассивДоп);
        СтруктураФР.Вставить("ПроверятьКакИ", Истина);
        
        МассивКарточек.Добавить(СтруктураФР);
    КонецЦикла;
    
    Отбор.Вставить("Карточки", МассивКарточек);
    
    // 2. Инициализируем МВТ и вызываем расчет (движок)
    МВТ = Новый МенеджерВременныхТаблиц;
    Справочники._Правила.СформироватьМВТ_ДоступныеПравила(Отбор, МВТ);
    
    // 3. Формируем итоговый запрос для вывода на форму в стиле таблицы "Условия"
    Запрос = Новый Запрос;
    Запрос.МенеджерВременныхТаблиц = МВТ;
    
    // В этом запросе мы НЕ дублируем логику проверки (И/ИЛИ, НеИспользовать, ПустаяСсылка и т.д.).
    // Мы берем готовый результат из ВТ_РезультатыПроверкиСтрок (которую рассчитал движок на Этапе 8),
    // а ВТ_РезультатыПроверок используем только чтобы красиво вывести левые и правые значения в отчет.
    
    Запрос.Текст = 
        "ВЫБРАТЬ
        |    Условия.НомерСтроки КАК НомерСтроки,
        |    Условия.Группа КАК Группа,
        |    Условия.ФункциональнаяРоль КАК ФункциональнаяРоль,
        |    Условия.ВидРеквизита КАК ВидРеквизита,
        |    Условия.ВидРеквизитаДополнение КАК ВидРеквизитаДополнение,
        |    
        |    ЕСТЬNULL(РезультатыПроверкиПервогоУсловия.ЗначениеКарточки, НЕОПРЕДЕЛЕНО) КАК ЗначениеСлева,
        |    Условия.Сравнение_1 КАК Сравнение_1,
        |    Условия.СпособПолученияЗначения_1 КАК СпособПолученияЗначения_1,
        |    ЕСТЬNULL(РезультатыПроверкиПервогоУсловия.ЗначениеПроверки, Условия.ЗначениеРеквизита_1) КАК ЗначениеСправа_1,
        |    ЕСТЬNULL(РезультатыПроверкиПервогоУсловия.Результат, ЛОЖЬ) КАК Выполнено_1,
        |    
        |    Условия.Сравнение_2 КАК Сравнение_2,
        |    Условия.СпособПолученияЗначения_2 КАК СпособПолученияЗначения_2,
        |    ЕСТЬNULL(РезультатыПроверкиВторогоУсловия.ЗначениеПроверки, Условия.ЗначениеРеквизита_2) КАК ЗначениеСправа_2,
        |    ЕСТЬNULL(РезультатыПроверкиВторогоУсловия.Результат, ЛОЖЬ) КАК Выполнено_2,
        |
        |    // Забираем уже готовый, вычисленный движком результат! Никакого дублирования логики.
        |    ВЫБОР 
        |        КОГДА ИтогИзДвижка.РезультатПроверки = 1 ТОГДА ИСТИНА
        |        ИНАЧЕ ЛОЖЬ
        |    КОНЕЦ КАК ИтогСтроки
        |    
        |ИЗ
        |    Справочник._Правила.Условия КАК Условия
        |        
        |        // 1. Получаем значения для вывода Чека 1
        |        ЛЕВОЕ СОЕДИНЕНИЕ (
        |            ВЫБРАТЬ 
        |                НомерСтроки, 
        |                МАКСИМУМ(ЗначениеКарточки) КАК ЗначениеКарточки, 
        |                МАКСИМУМ(ЗначениеПроверки) КАК ЗначениеПроверки, 
        |                МИНИМУМ(РезультатПроверки) КАК Результат 
        |            ИЗ ВТ_РезультатыПроверок 
        |            ГДЕ Чек = 1 И Правило = &Правило 
        |            СГРУППИРОВАТЬ ПО НомерСтроки
        |        ) КАК РезультатыПроверкиПервогоУсловия
        |        ПО Условия.НомерСтроки = РезультатыПроверкиПервогоУсловия.НомерСтроки
        |        
        |        // 2. Получаем значения для вывода Чека 2
        |        ЛЕВОЕ СОЕДИНЕНИЕ (
        |            ВЫБРАТЬ 
        |                НомерСтроки, 
        |                МАКСИМУМ(ЗначениеПроверки) КАК ЗначениеПроверки, 
        |                МИНИМУМ(РезультатПроверки) КАК Результат 
        |            ИЗ ВТ_РезультатыПроверок 
        |            ГДЕ Чек = 2 И Правило = &Правило 
        |            СГРУППИРОВАТЬ ПО НомерСтроки
        |        ) КАК РезультатыПроверкиВторогоУсловия
        |        ПО Условия.НомерСтроки = РезультатыПроверкиВторогоУсловия.НомерСтроки
        |
        |        // 3. Получаем ИТОГОВЫЙ результат всей строки, рассчитанный на ЭТАПЕ 8 движка
        |        ЛЕВОЕ СОЕДИНЕНИЕ ВТ_РезультатыПроверкиСтрок КАК ИтогИзДвижка
        |        ПО Условия.Ссылка = ИтогИзДвижка.Правило 
        |           И Условия.НомерСтроки = ИтогИзДвижка.НомерСтроки
        |           И Условия.ФункциональнаяРоль = ИтогИзДвижка.ФункциональнаяРоль
        |           И Условия.ВидРеквизита = ИтогИзДвижка.ВидРеквизита
        |           И ЕСТЬNULL(Условия.ВидРеквизитаДополнение, ЗНАЧЕНИЕ(ПланВидовХарактеристик._ВидыРеквизитов.ПустаяСсылка)) = ИтогИзДвижка.ВидРеквизитаДополнение
        |ГДЕ
        |    Условия.Ссылка = &Правило
        |
        |УПОРЯДОЧИТЬ ПО
        |    Условия.НомерСтроки";
        
    Запрос.УстановитьПараметр("Правило", Объект.Правило);
    
    Объект.РезультатыПроверки.Очистить();
    
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        НоваяСтрока = Объект.РезультатыПроверки.Добавить();
        ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
    КонецЦикла;
    
КонецПроцедуры