		ТекущиеДанные.ЭтоВидЗначения_Функция = Ложь;
		ТекущиеДанные.ЭтоВидЗначения_ИзРеквизитаФункцРоли = ИСТИНА;
		ТекущиеДанные.СпособВычисленияЗначения = ПредопределенноеЗначение("Перечисление._СпособыВычисленияЗначения.ИзРеквизитаФРоли");
	Иначе //Если Элемент.Имя="ДействияВидЗначения"	Тогда
		ТекущиеДанные.ЭтоВидЗначения_Значение = ИСТИНА;
		ТекущиеДанные.ЭтоВидЗначения_Функция = Ложь;
		ТекущиеДанные.ЭтоВидЗначения_ИзРеквизитаФункцРоли = Ложь;
		ТекущиеДанные.СпособВычисленияЗначения = ПредопределенноеЗначение("Перечисление._СпособыВычисленияЗначения.Значение");
	КонецЕсли;
	
	Если ТекущиеДанные.ЭтоВидЗначения_Значение = Ложь	Тогда
		//ТекущиеДанные.ЗначениеРеквизита = Неопределено;
	КонецЕсли;
	Если ТекущиеДанные.ЭтоВидЗначения_Функция = Ложь	Тогда
		//ТекущиеДанные.ФункцияПолученияЗначения = Неопределено;
	КонецЕсли;
	Если ТекущиеДанные.ЭтоВидЗначения_ИзРеквизитаФункцРоли = Ложь	Тогда
		//ТекущиеДанные.Действие_ФункциональнаяРоль = Неопределено;
		//ТекущиеДанные.Действие_ВидРеквизита = Неопределено;
