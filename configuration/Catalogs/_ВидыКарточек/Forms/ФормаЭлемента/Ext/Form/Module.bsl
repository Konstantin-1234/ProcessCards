
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЭтаФорма.ПравилоОбработкиКоманды.Параметры.УстановитьЗначениеПараметра("ВидКарточки",Объект.Ссылка);
	ЭтаФорма.ИсточникиФункциональныхРолей.Параметры.УстановитьЗначениеПараметра("ВидКарточки",Объект.Ссылка);
КонецПроцедуры

&НаКлиенте
Процедура РеквизитыПроверить(Элемент)
	ТекущиеДанные = ЭтаФорма.Элементы.Реквизиты.ТекущиеДанные;
	ТекущиеДанныеСтруктурой = Новый Структура("ВидРеквизита,Хранение,ВидРеквизитаВХранении,СтартовоеДействие,СтартовоеЗначениеРеквизита,ОшибкиЗаполнения");
	ЗаполнитьЗначенияСвойств(ТекущиеДанныеСтруктурой,ТекущиеДанные);
	РеквизитыВидРеквизитаВХраненииПриИзмененииНаСервере(ТекущиеДанныеСтруктурой);
	ЗаполнитьЗначенияСвойств(ТекущиеДанные,ТекущиеДанныеСтруктурой);
	
КонецПроцедуры

&НаСервере
Процедура РеквизитыВидРеквизитаВХраненииПриИзмененииНаСервере(ТекущиеДанные)
	ТекущиеДанные.ОшибкиЗаполнения = ""; // предлопожим, что ошибок заполнения нету
	Если ТипЗнч(ТекущиеДанные.Хранение) = Тип("ПланВидовХарактеристикСсылка._ВидыРеквизитов") Тогда 
		//делаю проверку заполнения "ВидРеквизитаВХранении" 
		ПараметрыПроверки_Хранение = Новый Структура ("ВидРеквизита",ТекущиеДанные.Хранение);
		Если ПустаяСтрока(ТекущиеДанные.ОшибкиЗаполнения)
		   И Объект.Реквизиты.НайтиСтроки(ПараметрыПроверки_Хранение).Количество() = 0 
		Тогда
			ТекущиеДанные.ОшибкиЗаполнения = "Поле 'Хранение' заполнено не корректно.";
		КонецЕсли;
		Если ПустаяСтрока(ТекущиеДанные.ОшибкиЗаполнения)
		   И ТекущиеДанные.Хранение.ВидКарточки.Реквизиты.Найти(ТекущиеДанные.ВидРеквизитаВХранении,"ВидРеквизита")=Неопределено 
		Тогда
			ТекущиеДанные.ОшибкиЗаполнения = "Поле 'ВидРеквизитаВХранении' заполнено не корректно.";
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры
